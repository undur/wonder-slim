<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="WOKeyValueConditional" content="expected" unknownAttributes="forbidden">

		<doc><![CDATA[Renders its content when the parent component's value for `key` equals `value` (compared with `equals()`; two nulls are equal). `negate` flips it.

Carried over from JavaWOExtensions (see #38).]]></doc>

		<binding name="key" required="true">
			<pull><type>java.lang.String</type></pull>
			<doc>A key path, evaluated on the parent component.</doc>
		</binding>

		<binding name="value">
			<pull><type>java.lang.Object</type></pull>
			<doc>The value to compare with. Null if not bound.</doc>
		</binding>

		<binding name="negate">
			<pull><type>java.lang.Object</type></pull>
			<doc>If true (a `Boolean`, a non-zero `Integer`, or the string `"true"`), content renders when the values *differ*.</doc>
		</binding>

	</wo>
</wodefinitions>
