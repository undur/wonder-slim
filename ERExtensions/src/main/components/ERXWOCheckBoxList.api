<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<wodefinitions>
	<wo class="ERXWOCheckBoxList" wocomponentcontent="false">
		<binding name="list"/>
		<binding name="item"/>
		<binding name="index"/>
		<binding name="displayString"/>
		<binding name="value"/>
		<binding name="selections"/>
		<binding name="prefix"/>
		<binding name="suffix"/>
		<binding name="name"/>
		<binding name="disabled" defaults="Boolean"/>
		<binding name="otherTagString"/>
		<validation message="'list' is a required binding">
			<unbound name="list"/>
		</validation>
	</wo>
</wodefinitions>
