<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<wodefinitions>
	<wo class="AjaxModalContainer" wocomponentcontent="true">

		<doc><![CDATA[Renders a trigger button that opens its inline content in a modal dialog, built on the platform's native `<dialog>` (free backdrop, focus trapping and Esc-to-close). The content stays in place in the DOM, so forms/links inside the dialog — including update containers — work exactly as anywhere else. Only the inline-content use is supported (iframe / direct-action / skin / locked modes are dropped).

```html
<wo:AjaxModalContainer label="Details" title="Order details" id="box">
  ...dialog content (may contain its own update container)...
</wo:AjaxModalContainer>
```]]></doc>

		<binding name="label">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The text on the trigger button.</doc>
		</binding>
		<binding name="title">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Optional title shown at the top of the dialog (and as the button's `title`).</doc>
		</binding>
		<binding name="closeLabel">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The text on the dialog's close button. Defaults to "Close".</doc>
		</binding>
		<binding name="open" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>If true, the dialog is open on initial render.</doc>
		</binding>
		<binding name="id">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Optional id for the trigger button.</doc>
		</binding>
		<binding name="class">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The HTML class attribute, passed through to the trigger button.</doc>
		</binding>
		<binding name="style">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The HTML style attribute, passed through to the trigger button.</doc>
		</binding>

	</wo>
</wodefinitions>
