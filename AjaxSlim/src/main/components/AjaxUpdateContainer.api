<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<wodefinitions>
	<wo class="AjaxUpdateContainer" wocomponentcontent="true">
		<binding name="id"/>
		<binding name="elementName"/>
		<binding name="onRefreshComplete"/>

		<binding defaults="Boolean" name="optional"/>
		<binding name="morph" defaults="Boolean"/>
	</wo>
</wodefinitions>
