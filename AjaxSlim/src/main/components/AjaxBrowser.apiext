<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="AjaxBrowser" content="forbidden" unknownAttributes="passthrough">

		<doc><![CDATA[The multi-select companion to `AjaxPopUpButton`: a drop-in `WOBrowser` that renders the same searchable wonder-select widget with removable tags instead of a bare multi-select. The shared `wonder-select.js` reads the `<select>`'s `multiple` attribute to switch between single value and removable tags.

```html
<wo:AjaxBrowser list="$items" item="$item" selections="$selected"
  multiple="$true" displayString="$item.name" noSelectionString="Add some…"/>
```]]></doc>

		<binding name="list" required="true">
			<pull><type>java.util.List</type></pull>
			<doc>The list of objects to choose from.</doc>
		</binding>

		<binding name="item">
			<pull><type>java.lang.Object</type></pull>
			<doc>The repetition item during rendering.</doc>
		</binding>

		<binding name="selections">
			<pull><type>java.util.List</type></pull>
			<push><type>java.util.List</type></push>
			<doc>The currently selected objects (settable).</doc>
		</binding>

		<binding name="selectedValues">
			<pull><type>java.util.List</type></pull>
			<push><type>java.util.List</type></push>
			<doc><![CDATA[Value-based multi-selection (as on `WOBrowser`).]]></doc>
		</binding>

		<binding name="value">
			<pull><type>java.lang.Object</type></pull>
			<doc><![CDATA[The value for each option, taken from `item` during rendering.]]></doc>
		</binding>

		<binding name="multiple">
			<pull><type>java.lang.Boolean</type></pull>
			<doc><![CDATA[Whether the browser is multi-select (bind `multiple="$true"` for tags).]]></doc>
		</binding>

		<binding name="displayString">
			<pull><type>java.lang.String</type></pull>
			<doc>The text shown for each option.</doc>
		</binding>

		<binding name="otherTagString">
			<pull><type>java.lang.String</type></pull>
			<deprecated>Unknown attributes pass through to the rendered tag natively — write them directly on the element instead.</deprecated>
			<doc><![CDATA[Extra attributes appended to the rendered `<select>` tag.]]></doc>
		</binding>

		<binding name="disabled">
			<pull><type>java.lang.Boolean</type></pull>
			<doc><![CDATA[Standard `WOBrowser` behaviour — renders the select as disabled.]]></doc>
		</binding>

		<binding name="escapeHTML">
			<pull><type>java.lang.Boolean</type></pull>
			<doc><![CDATA[Standard `WOBrowser` behaviour — whether the display string is HTML-escaped.]]></doc>
		</binding>

		<binding name="id">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[Standard HTML `id` attribute.]]></doc>
		</binding>

		<binding name="name">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[Standard HTML `name` attribute.]]></doc>
		</binding>

		<binding name="class">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[Standard HTML `class` attribute.]]></doc>
		</binding>

		<binding name="style">
			<pull><type>java.lang.String</type></pull>
			<doc><![CDATA[Standard HTML `style` attribute.]]></doc>
		</binding>

		<requires binding="list" must="gettable"/>
		<requires binding="item" must="settable">
			<any-of><binding name="displayString"/><binding name="value"/></any-of>
		</requires>
		<requires binding="item">
			<any-of><binding name="displayString"/><binding name="value"/></any-of>
		</requires>
		<choose max="1">
			<binding name="selections"/>
			<binding name="selectedValues"/>
		</choose>

	</wo>
</wodefinitions>
