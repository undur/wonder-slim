<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<wodefinitions>
	<wo class="AjaxBrowser" wocomponentcontent="false">

		<doc><![CDATA[The multi-select companion to `AjaxPopUpButton`: a drop-in `WOBrowser` that renders the same searchable wonder-select widget with removable tags instead of a bare multi-select. The shared `wonder-select.js` reads the `<select>`'s `multiple` attribute to switch between single value and removable tags.

```html
<wo:AjaxBrowser list="$items" item="$item" selections="$selected"
  multiple="$true" displayString="$item.name" noSelectionString="Add some…"/>
```]]></doc>

		<binding name="list" required="true">
			<pull>
				<type>java.util.List</type>
			</pull>
			<doc>The list of objects to choose from.</doc>
		</binding>
		<binding name="item">
			<pull>
				<type>java.lang.Object</type>
			</pull>
			<doc>The repetition item during rendering.</doc>
		</binding>
		<binding name="selections" settable="YES">
			<pull>
				<type>java.util.List</type>
			</pull>
			<push>
				<type>java.util.List</type>
			</push>
			<doc>The currently selected objects (settable).</doc>
		</binding>
		<binding name="selectedValues">
			<pull>
				<type>java.util.List</type>
			</pull>
			<push>
				<type>java.util.List</type>
			</push>
			<doc>Value-based multi-selection (as on `WOBrowser`).</doc>
		</binding>
		<binding name="value">
			<pull>
				<type>java.lang.Object</type>
			</pull>
			<doc>The value for each option, taken from `item` during rendering.</doc>
		</binding>
		<binding name="multiple">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>Whether the browser is multi-select (bind `multiple="$true"` for tags).</doc>
		</binding>
		<binding name="displayString">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The text shown for each option.</doc>
		</binding>
		<binding name="otherTagString">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Extra attributes appended to the rendered `&lt;select&gt;` tag.</doc>
		</binding>
		<binding name="disabled" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>Standard `WOBrowser` behaviour — renders the select as disabled.</doc>
		</binding>
		<binding name="escapeHTML" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>Standard `WOBrowser` behaviour — whether the display string is HTML-escaped.</doc>
		</binding>

		<binding name="id">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Standard HTML `id` attribute.</doc>
		</binding>
		<binding name="name">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Standard HTML `name` attribute.</doc>
		</binding>
		<binding name="class">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Standard HTML `class` attribute.</doc>
		</binding>
		<binding name="style">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>Standard HTML `style` attribute.</doc>
		</binding>

		<validation message="'list' must not be a constant">
			<and>
				<bound name="list"/>
				<ungettable name="list"/>
			</and>
		</validation>

		<validation message="'item' may not be a constant when 'displayString' or 'value' is bound">
			<and>
				<or>
					<bound name="displayString"/>
					<bound name="value"/>
				</or>
				<unsettable name="item"/>
			</and>
		</validation>

		<validation message="'item' must be bound when 'displayString' or 'value' is bound">
			<and>
				<unbound name="item"/>
				<or>
					<bound name="value"/>
					<bound name="displayString"/>
				</or>
			</and>
		</validation>

		<validation message="'selectedValues' and 'selections' cannot both be bound">
			<and>
				<bound name="selections"/>
				<bound name="selectedValues"/>
			</and>
		</validation>
	</wo>
</wodefinitions>
