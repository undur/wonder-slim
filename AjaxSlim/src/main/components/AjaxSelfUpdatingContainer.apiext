<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<wodefinitions>
	<wo class="AjaxSelfUpdatingContainer" wocomponentcontent="true" passthrough="true">

		<doc><![CDATA[An update container that refreshes **itself** — on a timer (`frequency`) and/or when a field changes (`observeFieldID`) — and may invoke its own `action` when it does. The counterpart to the passive `AjaxUpdateContainer`; it also inherits all of that element's bindings (`id`, `elementName`, `morph`, `onRefreshComplete`, `optional`) and the same attribute passthrough (`class`, `style`, `data-*`, …).

```html
<wo:AjaxSelfUpdatingContainer id="clock" frequency="5" action="$tick">
  Server time: <wo:str value="$now"/>
</wo:AjaxSelfUpdatingContainer>
```]]></doc>

		<binding name="frequency">
			<pull>
				<type>java.lang.Number</type>
			</pull>
			<doc>The frequency, in seconds, of a periodic self-refresh.</doc>
		</binding>
		<binding name="stopped" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>Whether a periodic container loads stopped (so it can be started later by refreshing it).</doc>
		</binding>
		<binding name="observeFieldID">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The DOM id of a field whose changes trigger a self-refresh of this container.</doc>
		</binding>
		<binding name="fullSubmit" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>When observing a field, whether to submit the whole form (true) or just the field (false).</doc>
		</binding>
		<binding name="action">
			<pull>
				<type>com.webobjects.appserver.WOActionResults</type>
			</pull>
			<doc>The action to invoke when this container refreshes itself.</doc>
		</binding>

		<binding name="id">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The DOM id of the container (defaults to a safe generated element id). This is the id other elements target.</doc>
		</binding>
		<binding name="elementName">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>The HTML tag to render. Defaults to `div`.</doc>
		</binding>
		<binding name="morph" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>When true (the default), content updates reconcile the existing DOM via Idiomorph — preserving focus/scroll/selection and unchanged subtrees. Bind `morph="$false"` to force classic `innerHTML` replacement.</doc>
		</binding>
		<binding name="onRefreshComplete">
			<pull>
				<type>java.lang.String</type>
			</pull>
			<doc>JavaScript to run after the container has been refreshed/morphed.</doc>
		</binding>
		<binding name="optional" defaults="Boolean">
			<pull>
				<type>java.lang.Boolean</type>
			</pull>
			<doc>Set true to skip rendering the container tags when this element is already inside another update container (renders only its children).</doc>
		</binding>

	</wo>
</wodefinitions>
