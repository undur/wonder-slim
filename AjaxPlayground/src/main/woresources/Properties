# AjaxPlayground configuration.
#
# wolips.host/port point at the Parslips dev server so this app announces its port at startup and
# shows up in http://localhost:9485/apps - that's how the dev loop discovers where it is running.
wolips.host=localhost
wolips.port=9485

# Log the unified page cache size + page->container structure on every store - so you can watch
# the cache stay bounded by page instances instead of growing per interaction. Dev/showcase only;
# off by default in the framework.
er.extensions.appserver.ajax.ERXAjaxSession.logPageCache=true

# Logging. Without an explicit appender, log4j falls back to a default layout whose timestamp is %r
# (milliseconds since logging started) - which reads like a counter, not a clock. Configure a console
# appender with a dated pattern so the Eclipse console shows real wall-clock times (and the
# "No appenders could be found" warning goes away).
log4j.loggerFactory=er.extensions.logging.ERXLogger$Factory
log4j.rootCategory=INFO, A1
log4j.appender.A1=org.apache.log4j.ConsoleAppender
log4j.appender.A1.layout=er.extensions.logging.ERXPatternLayout
log4j.appender.A1.layout.ConversionPattern=%d{MMM dd HH:mm:ss} %-5p %c - %m%n
