<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>is.rebbi.slim</groupId>
		<artifactId>wonder-slim-reactor</artifactId>
		<version>8.0.5-SNAPSHOT</version>
	</parent>
	<artifactId>AjaxPlayground</artifactId>
	<name>Ajax Playground</name>
	<packaging>woapplication</packaging>

	<description>
		A login-free, database-free WebObjects application that exercises the Ajax framework's
		components - the canonical test surface for the morph-as-default work and the wider Ajax
		cleanup. Component-gallery pages plus danger-matrix scenario pages.
	</description>

	<properties>
		<!--
			This is a purely local test/demo application, not a release artifact: it must NOT be
			published to the WOCommunity repository alongside the frameworks. It is kept as a reactor
			module only so it builds and is exercised during development; deployment is skipped.
			(It also depends on a SNAPSHOT adaptor, which a released artifact could not.)
		-->
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<build>
		<finalName>${project.artifactId}</finalName>
	</build>

	<dependencies>
		<dependency>
			<groupId>is.rebbi</groupId>
			<artifactId>wo-adaptor-jetty</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>is.rebbi</groupId>
			<artifactId>wo-adaptor-jetty-websocket</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>${wonder.core.group}</groupId>
			<artifactId>ERExtensions</artifactId>
			<version>${wonder.version}</version>
		</dependency>
		<dependency>
			<groupId>${wonder.core.group}</groupId>
			<artifactId>ERLoggingReload4j</artifactId>
			<version>${wonder.version}</version>
		</dependency>
		<dependency>
			<groupId>${wonder.ajax.group}</groupId>
			<artifactId>AjaxSlim</artifactId>
			<version>${wonder.version}</version>
		</dependency>
	</dependencies>
</project>
