Content : WOComponentContent {
}

AccordionDiv : WOGenericContainer {
	elementName = "div";
	id = accordionID;
	class = "accordion";
	otherTagString = "data-morph-ignore=\"true\"";
}

AccordionContainerID : WOString {
	value = accordionID;
}

AjaxOptions : AjaxOptions {
	options = createAjaxOptions;
}