{
  "url": "http://localhost:<PORT>/cgi-bin/WebObjects/AjaxPlayground.woa/wa/page?name=ScenarioFocus",
  "steps": [
    {
      "do": "goto"
    },
    {
      "do": "wait",
      "selector": "#focusContainer"
    },
    {
      "do": "read",
      "name": "morphAttr",
      "selector": "#focusContainer",
      "what": "attribute",
      "attr": "data-morph"
    },
    {
      "do": "focus",
      "selector": "#firstNameField"
    },
    {
      "do": "type",
      "selector": "#firstNameField",
      "text": "Ada",
      "delay": 40
    },
    {
      "do": "press",
      "selector": "#firstNameField",
      "key": "Tab"
    },
    {
      "do": "wait",
      "ms": 1000
    },
    {
      "do": "read",
      "name": "afterFirstMorph_active",
      "what": "activeElementId"
    },
    {
      "do": "read",
      "name": "afterFirstMorph_greeting",
      "selector": ".greeting",
      "what": "text"
    },
    {
      "do": "read",
      "name": "firstStillThere",
      "selector": "#firstNameField",
      "what": "value"
    },
    {
      "do": "focus",
      "selector": "#lastNameField"
    },
    {
      "do": "type",
      "selector": "#lastNameField",
      "text": "Lovelace",
      "delay": 40
    },
    {
      "do": "read",
      "name": "midType_active",
      "what": "activeElementId"
    },
    {
      "do": "read",
      "name": "midType_value",
      "selector": "#lastNameField",
      "what": "value"
    },
    {
      "do": "assert",
      "name": "morph on",
      "that": "morphAttr",
      "equals": "true"
    },
    {
      "do": "assert",
      "name": "firstName value survived its own morph",
      "that": "firstStillThere",
      "equals": "Ada"
    },
    {
      "do": "assert",
      "name": "greeting recomputed after morph",
      "that": "afterFirstMorph_greeting",
      "contains": "Ada"
    },
    {
      "do": "assert",
      "name": "focus on lastName while typing (not stolen by prior morph)",
      "that": "midType_active",
      "equals": "lastNameField"
    },
    {
      "do": "assert",
      "name": "lastName typing intact",
      "that": "midType_value",
      "equals": "Lovelace"
    }
  ],
  "_comment": "Focus-survival test. Get <PORT> from the running app (lsof / app startup log; the jetty adaptor uses an ephemeral port). The descendant AjaxObserveField fires on the CHANGE event (blur/Tab), not per keystroke - so each field is committed with Tab to trigger the container morph."
}
