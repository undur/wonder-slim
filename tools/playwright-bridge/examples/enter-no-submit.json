{
  "url": "http://localhost:<PORT>/cgi-bin/WebObjects/AjaxPlayground.woa/wa/page?name=GalleryAjaxPopUpButton",
  "steps": [
    {
      "do": "goto"
    },
    {
      "do": "wait",
      "selector": "wonder-select .ws-trigger"
    },
    {
      "do": "comment",
      "text": "Enter on trigger must NOT submit/break the page and must NOT open"
    },
    {
      "do": "focus",
      "selector": "wonder-select .ws-trigger"
    },
    {
      "do": "press",
      "selector": "wonder-select .ws-trigger",
      "key": "Enter"
    },
    {
      "do": "wait",
      "ms": 400
    },
    {
      "do": "read",
      "name": "pageIntact",
      "selector": "h1",
      "what": "text"
    },
    {
      "do": "read",
      "name": "openedOnEnter",
      "selector": "wonder-select.ws-open",
      "what": "exists"
    },
    {
      "do": "read",
      "name": "widgetIntact",
      "selector": "wonder-select .ws-trigger",
      "what": "exists"
    },
    {
      "do": "comment",
      "text": "Space still opens"
    },
    {
      "do": "press",
      "selector": "wonder-select .ws-trigger",
      "key": " "
    },
    {
      "do": "wait",
      "ms": 250
    },
    {
      "do": "read",
      "name": "openedOnSpace",
      "selector": "wonder-select.ws-open",
      "what": "exists"
    },
    {
      "do": "comment",
      "text": "search-box Enter selects the highlighted option, does NOT submit/break"
    },
    {
      "do": "type",
      "selector": "wonder-select .ws-search",
      "text": "Man",
      "delay": 25
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "press",
      "selector": "wonder-select .ws-search",
      "key": "Enter"
    },
    {
      "do": "wait",
      "ms": 700
    },
    {
      "do": "read",
      "name": "pickedViaEnter",
      "selector": "wonder-select .ws-trigger",
      "what": "text"
    },
    {
      "do": "read",
      "name": "pageStillIntact",
      "selector": "h1",
      "what": "text"
    },
    {
      "do": "assert",
      "name": "Enter on trigger leaves page intact (no submit)",
      "that": "pageIntact",
      "contains": "AjaxPopUpButton"
    },
    {
      "do": "assert",
      "name": "Enter on trigger does NOT open",
      "that": "openedOnEnter",
      "equals": false
    },
    {
      "do": "assert",
      "name": "widget intact after trigger Enter",
      "that": "widgetIntact",
      "equals": true
    },
    {
      "do": "assert",
      "name": "Space opens the dropdown",
      "that": "openedOnSpace",
      "equals": true
    },
    {
      "do": "assert",
      "name": "search Enter selects (Mango)",
      "that": "pickedViaEnter",
      "contains": "Mango"
    },
    {
      "do": "assert",
      "name": "search Enter did not break the page",
      "that": "pageStillIntact",
      "contains": "AjaxPopUpButton"
    }
  ]
}
