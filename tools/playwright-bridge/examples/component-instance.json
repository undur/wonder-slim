{
  "url": "http://127.0.0.1:<PORT>/component-instance",
  "comment": "ERXWOComponentInstance: a page constructs and configures a component instance, then embeds it. Asserts construction-time configuration shows, the instance's own state survives across requests (its action advances a counter), the page can call methods on the instance directly, binding passing coexists, wrapped content renders, binding a new instance replaces the embedded one (label changes, state resets), and a stateless instance is refused with an exception.",
  "steps": [
    { "do": "goto" },
    { "do": "wait", "selector": "#embedded" },
    { "do": "read", "name": "label", "what": "text", "selector": "#embeddedLabel" },
    { "do": "assert", "name": "label set at construction time renders", "that": "label", "equals": "first" },
    { "do": "read", "name": "count0", "what": "text", "selector": "#embeddedCount" },
    { "do": "assert", "name": "counter starts at zero", "that": "count0", "equals": "0" },
    { "do": "read", "name": "note", "what": "text", "selector": "#embeddedNote" },
    { "do": "assert", "name": "a binding passed alongside the instance is pulled", "that": "note", "equals": "hello from the page" },
    { "do": "read", "name": "wrapped", "what": "text", "selector": "#wrapped" },
    { "do": "assert", "name": "wrapped content renders through the instance's wo:content", "that": "wrapped", "contains": "Wrapped content" },
    { "do": "click", "selector": "#bumpLink" },
    { "do": "wait", "selector": "#embedded" },
    { "do": "click", "selector": "#bumpLink" },
    { "do": "wait", "selector": "#embedded" },
    { "do": "read", "name": "count2", "what": "text", "selector": "#embeddedCount" },
    { "do": "assert", "name": "the instance's own action advances state that survives across requests", "that": "count2", "equals": "2" },
    { "do": "click", "selector": "#bumpDirectlyLink" },
    { "do": "wait", "selector": "#embedded" },
    { "do": "read", "name": "count3", "what": "text", "selector": "#embeddedCount" },
    { "do": "assert", "name": "the page can call a method on the instance directly", "that": "count3", "equals": "3" },
    { "do": "click", "selector": "#replaceLink" },
    { "do": "wait", "selector": "#embedded" },
    { "do": "read", "name": "label2", "what": "text", "selector": "#embeddedLabel" },
    { "do": "assert", "name": "binding a new instance replaces the embedded component", "that": "label2", "equals": "generation 2" },
    { "do": "read", "name": "countAfterReplace", "what": "text", "selector": "#embeddedCount" },
    { "do": "assert", "name": "the replacement starts with its own fresh state", "that": "countAfterReplace", "equals": "0" },
    { "do": "click", "selector": "#bumpLink" },
    { "do": "wait", "selector": "#embedded" },
    { "do": "read", "name": "countAfterReplaceBump", "what": "text", "selector": "#embeddedCount" },
    { "do": "assert", "name": "the replacement's own action works", "that": "countAfterReplaceBump", "equals": "1" },
    { "do": "click", "selector": "#breakLink" },
    { "do": "wait", "ms": 500 },
    { "do": "read", "name": "statelessRefused", "what": "jsExpression", "expression": "document.body.textContent.includes('StatelessProbe is stateless') ? 'refused' : 'not refused'" },
    { "do": "assert", "name": "a stateless instance is refused loudly", "that": "statelessRefused", "equals": "refused" }
  ]
}
