{
  "url": "http://localhost:<PORT>/cgi-bin/WebObjects/AjaxPlayground.woa/wa/page?name=GalleryAjaxBrowser",
  "steps": [
    {
      "do": "goto"
    },
    {
      "do": "wait",
      "selector": "wonder-select .ws-trigger"
    },
    {
      "do": "read",
      "name": "isMulti",
      "selector": "wonder-select.ws-multiple",
      "what": "exists"
    },
    {
      "do": "comment",
      "text": "pick Mango -> list closes, search clears, focus kept"
    },
    {
      "do": "click",
      "selector": "wonder-select .ws-trigger"
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "type",
      "selector": "wonder-select .ws-search",
      "text": "Man",
      "delay": 25
    },
    {
      "do": "wait",
      "ms": 120
    },
    {
      "do": "click",
      "selector": "wonder-select .ws-option:not(.ws-disabled)"
    },
    {
      "do": "wait",
      "ms": 250
    },
    {
      "do": "read",
      "name": "closedAfterPick",
      "selector": "wonder-select.ws-open",
      "what": "exists"
    },
    {
      "do": "read",
      "name": "focusKept",
      "selector": "wonder-select :focus",
      "what": "exists"
    },
    {
      "do": "comment",
      "text": "reopen (search empty), pick Grape -> two tags"
    },
    {
      "do": "click",
      "selector": "wonder-select .ws-trigger"
    },
    {
      "do": "wait",
      "ms": 150
    },
    {
      "do": "read",
      "name": "searchEmptyOnReopen",
      "selector": "wonder-select .ws-search",
      "what": "value"
    },
    {
      "do": "type",
      "selector": "wonder-select .ws-search",
      "text": "Grape",
      "delay": 25
    },
    {
      "do": "wait",
      "ms": 120
    },
    {
      "do": "click",
      "selector": "wonder-select .ws-option:not(.ws-disabled)"
    },
    {
      "do": "wait",
      "ms": 250
    },
    {
      "do": "read",
      "name": "tagCount",
      "selector": "wonder-select .ws-tag",
      "what": "count"
    },
    {
      "do": "comment",
      "text": "commit to server"
    },
    {
      "do": "press",
      "selector": "wonder-select .ws-trigger",
      "key": "Tab"
    },
    {
      "do": "wait",
      "ms": 800
    },
    {
      "do": "read",
      "name": "echo",
      "selector": "#echo",
      "what": "text"
    },
    {
      "do": "comment",
      "text": "remove a tag"
    },
    {
      "do": "click",
      "selector": "wonder-select .ws-tag .ws-tag-remove"
    },
    {
      "do": "wait",
      "ms": 200
    },
    {
      "do": "read",
      "name": "tagCountAfterRemove",
      "selector": "wonder-select .ws-tag",
      "what": "count"
    },
    {
      "do": "comment",
      "text": "morph the container, tags survive"
    },
    {
      "do": "click",
      "selector": "#refreshLink"
    },
    {
      "do": "wait",
      "ms": 900
    },
    {
      "do": "read",
      "name": "tagCountAfterMorph",
      "selector": "wonder-select .ws-tag",
      "what": "count"
    },
    {
      "do": "assert",
      "name": "rendered as multi-select",
      "that": "isMulti",
      "equals": true
    },
    {
      "do": "assert",
      "name": "list closes after a pick",
      "that": "closedAfterPick",
      "equals": false
    },
    {
      "do": "assert",
      "name": "focus kept after pick",
      "that": "focusKept",
      "equals": true
    },
    {
      "do": "assert",
      "name": "search cleared on reopen",
      "that": "searchEmptyOnReopen",
      "equals": ""
    },
    {
      "do": "assert",
      "name": "two picks accumulate to two tags",
      "that": "tagCount",
      "equals": 2
    },
    {
      "do": "assert",
      "name": "server got Mango",
      "that": "echo",
      "contains": "Mango"
    },
    {
      "do": "assert",
      "name": "server got Grape",
      "that": "echo",
      "contains": "Grape"
    },
    {
      "do": "assert",
      "name": "remove tag -> one",
      "that": "tagCountAfterRemove",
      "equals": 1
    },
    {
      "do": "assert",
      "name": "tags survive morph",
      "that": "tagCountAfterMorph",
      "equals": 1
    }
  ]
}
