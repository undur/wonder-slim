<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>is.rebbi.slim</groupId>
		<artifactId>wonder-slim-reactor</artifactId>
		<version>8.1.2-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>Bookclubs</artifactId>
	<name>Bookclubs</name>
	<packaging>woapplication</packaging>

	<description>
		Book clubs, each on a host of its own: the example application for the router (docs/ROUTING.md),
		using every feature of it.
	</description>

	<properties>
		<!--
			An example application, not a release artifact: it must NOT be published to the WOCommunity
			repository alongside the frameworks. It is a reactor module so it builds with them, and a change
			to the router that breaks it shows; deployment is skipped.
		-->
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<build>
		<finalName>${project.artifactId}</finalName>
	</build>

	<dependencies>
		<dependency>
			<groupId>is.rebbi.slim</groupId>
			<artifactId>ERExtensions</artifactId>
			<version>${wonder.version}</version>
		</dependency>
		<dependency>
			<groupId>is.rebbi</groupId>
			<artifactId>wo-adaptor-jetty</artifactId>
			<version>0.12.2</version>
		</dependency>
	</dependencies>
</project>
