# AjaxPlayground configuration.
#
# wolips.port points at the Parslips dev server on localhost so this app announces its port at startup
# and shows up in http://localhost:9485/apps - that's how the dev loop discovers where it is running.
wolips.port=9485

# Log the unified page cache size + page->container structure on every store - so you can watch
# the cache stay bounded by page instances instead of growing per interaction. Dev/showcase only;
# off by default in the framework.
er.extensions.appserver.ajax.ERXAjaxSession.logPageCache=true

