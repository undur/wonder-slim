<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="WOPasswordField" content="forbidden" unknownAttributes="passthrough">

		<doc><![CDATA[A masked text field (`<input type="password">`). The current `value` is **pulled** and rendered into the tag's `value` attribute; on submit the field **pushes** whatever the user entered into its `value` binding.]]></doc>

		<binding name="value" required="true">
			<pull><type>java.lang.Object</type></pull>
			<push><type>java.lang.String</type></push>
			<doc><![CDATA[The field's value. Required, and must be a settable keypath — the element rejects a constant at construction. On submit the raw form string is **pushed** back as a `java.lang.String` (even when empty or null). The current value is also **pulled** when rendering the tag.]]></doc>
		</binding>

		<binding name="name">
			<pull><type>java.lang.String</type></pull>
			<doc>The HTML form-field name. Pulled; auto-assigned from the element ID when unbound.</doc>
		</binding>

		<binding name="escapeHTML" defaults="YES/NO">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<doc><![CDATA[Whether the `name` and `value` attributes are HTML-escaped. **Pulled** by truthiness. WebObjects also renders it onto the tag as an `escapeHTML` attribute.]]></doc>
		</binding>

		<binding name="disabled" defaults="YES/NO">
			<pull><type interpretation="truthy">java.lang.Object</type></pull>
			<doc><![CDATA[If truthy, renders the field disabled and skips reading its submitted value (so nothing is pushed to `value`).]]></doc>
		</binding>

	</wo>
</wodefinitions>
