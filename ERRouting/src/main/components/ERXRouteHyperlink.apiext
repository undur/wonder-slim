<?xml version="1.0" encoding="UTF-8"?>
<wodefinitions>
	<wo class="ERXRouteHyperlink" content="allowed" unknownAttributes="passthrough">

		<doc><![CDATA[EXPERIMENTAL (route-links branch). Renders a link, `<a>`, to a route (`<wo:route>`): `route` binds the route, and attributes prefixed with `:` are its parameters (`:id="$item.id"`). The URL is the route's URL for them. An unknown parameter, a missing path parameter or a value of the wrong type is an error when the link renders.

Attributes prefixed with `?` become further query parameters (`?highlight="yes"`). Every other attribute is rendered on the tag. For links to anything other than a route, use `<wo:link>`.]]></doc>

		<binding name="route" required="true"><pull><type>er.routing.Linkable</type></pull><doc>Route to link to: a typed route or a plain one. Its parameters are bound with `:` attributes.</doc></binding>
		<binding name="queryDictionary"><pull><type>java.util.Map</type></pull><doc>Query parameters added to the URL.</doc></binding>
		<binding name="fragmentIdentifier"><pull><type>java.lang.String</type></pull><doc>Fragment (`#…`) appended to the URL.</doc></binding>
		<binding name="secure"><pull><type>java.lang.Boolean</type></pull><doc>Generate an https URL.</doc></binding>
		<binding name="string"><pull><type>java.lang.String</type></pull><doc>Text of the link.</doc></binding>
		<binding name="target"><pull><type>java.lang.String</type></pull><doc>The link's `target` attribute.</doc></binding>
		<binding name="disabled"><pull><type interpretation="truthy">java.lang.Object</type></pull><doc>If true, renders the content without a link.</doc></binding>

	</wo>
</wodefinitions>
